<UserControl x:Class="AquaDesk.View.Arac"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AquaDesk.View"
             xmlns:h="http://helix-toolkit.org/wpf"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <!-- 3D Viewport -->
        <h:HelixViewport3D x:Name="view3d" Grid.Column="0">
            <h:SunLight />
            <ModelVisual3D x:Name="ModelContainer" />
        </h:HelixViewport3D>

        <!-- Sliders -->
        <StackPanel Grid.Column="1" Margin="10">
            <TextBlock Text="Rotasyon X" Style="{StaticResource Arayuztext}"/>
            <Slider Minimum="0" Maximum="360" Value="180" ValueChanged="SliderX_ValueChanged" />
            <TextBlock Text="Rotasyon Y" Style="{StaticResource Arayuztext}" />
            <Slider Minimum="0" Maximum="360" Value="180" ValueChanged="SliderY_ValueChanged" />
            <TextBlock Text="Rotasyon Z" Style="{StaticResource Arayuztext}" />
            <Slider Minimum="0" Maximum="360" Value="180" ValueChanged="SliderZ_ValueChanged" />
        </StackPanel>
    </Grid>
</UserControl>
