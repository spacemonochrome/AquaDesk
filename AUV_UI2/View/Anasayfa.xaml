<UserControl x:Class="AquaDesk.View.Anasayfa"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
             xmlns:local="clr-namespace:AquaDesk.View"
             mc:Ignorable="d" 
             d:DesignHeight="1688" d:DesignWidth="1298">
    <Grid>
        <!-- Satır Tanımlamaları -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Bağlantı başlığı -->
            <RowDefinition Height="*"/>
            <!-- Ana içerik -->
        </Grid.RowDefinitions>

        <!-- Sütun Tanımlamaları -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" MinWidth="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ÜST BAŞLIK -->
        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Bağlantı" 
               FontSize="24" FontWeight="Bold" Margin="10" 
               Style="{StaticResource Arayuztext}"/>

        <!-- SOL PANEL -->
        <StackPanel Grid.Row="1" Grid.Column="0" Margin="10">
            <!-- Bağlan / Bağlantıyı Kes Butonları -->
            <Button Height="40" Margin="0 5" Style="{StaticResource ModernButton}">
                <StackPanel Orientation="Horizontal">
                    <fa:IconBlock Icon="Wifi" Width="20" Margin="0 0 10 0"/>
                    <TextBlock Text="Bağlan" Style="{StaticResource butontext}"/>
                </StackPanel>
            </Button>

            <Button Height="40" Margin="0 5" Style="{StaticResource ModernButton}">
                <StackPanel Orientation="Horizontal">
                    <fa:IconBlock Icon="Unlink" Width="20" Margin="0 0 10 0"/>
                    <TextBlock Text="Bağlantıyı Kes" Style="{StaticResource butontext}"/>
                </StackPanel>
            </Button>

            <!-- IP, Kullanıcı Adı, Şifre -->
            <TextBlock Text="IP Adresi" Margin="0 10 0 5" Style="{StaticResource icerik}" FontWeight="SemiBold"/>
            <TextBox Height="30" FontSize="16" Style="{StaticResource kutucuk}" Foreground="White"/>

            <TextBlock Text="Kullanıcı Adı" Margin="0 10 0 5" Style="{StaticResource icerik}" FontWeight="SemiBold"/>
            <TextBox Height="30" FontSize="16" Style="{StaticResource kutucuk}" Foreground="White"/>

            <TextBlock Text="Şifre" Margin="0 10 0 5" Style="{StaticResource icerik}" FontWeight="SemiBold"/>
            <TextBox Height="30" FontSize="16" Style="{StaticResource kutucuk}" Foreground="White"/>

            <!-- Bağlantı Durumu -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0 20 0 0">
                <TextBlock Text="Bağlantı Durumu" Style="{StaticResource Arayuztext}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <fa:IconImage Icon="Chain" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource color9}" Width="30" Height="30" Margin="10,0,0,0" Style="{StaticResource controlButtonIcon}"/>
            </StackPanel>
        </StackPanel>

        <!-- SAĞ PANEL -->
        <Grid Grid.Row="1" Grid.Column="1" Margin="10,0,10,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <!-- Terminal -->
                <RowDefinition Height="Auto"/>
                <!-- Alt Butonlar -->
            </Grid.RowDefinitions>

            <!-- Terminal -->
            <Border Grid.Row="0" Background="Black" CornerRadius="10" BorderBrush="Gray" BorderThickness="1" Margin="0,10,0,10">
                <TextBox Background="{StaticResource plainTextColor2}" 
                     Foreground="White" 
                     FontFamily="Plus Jakarta Sans" 
                     FontSize="14"
                     AcceptsReturn="True"
                     TextWrapping="Wrap" 
                     VerticalScrollBarVisibility="Auto"
                     BorderThickness="0"
                     VerticalAlignment="Stretch"
                     Padding="10"
                     Style="{StaticResource kutucuk2}"/>
            </Border>

            <!-- ALT BUTONLAR -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Stretch" Margin="0">
                <!-- İşlemi Durdur -->
                <Button Style="{StaticResource ModernButton}" Width="144" Height="40" Margin="0 20 20 0">
                    <StackPanel Orientation="Horizontal">
                        <fa:IconBlock Icon="Stop" Width="20" Margin="0 0 10 0"/>
                        <TextBlock Text="İşlemi Durdur" Style="{StaticResource butontext}"/>
                    </StackPanel>
                </Button>

                <!-- Komut Gönder -->
                <Button Style="{StaticResource ModernButton}" Width="144" Height="40"  Margin="0 20 20 0">
                    <StackPanel Orientation="Horizontal">
                        <fa:IconBlock Icon="Code" Width="20" Margin="0 0 10 0"/>
                        <TextBlock Text="Komut Gönder" Style="{StaticResource butontext}"/>
                    </StackPanel>
                </Button>

                <!-- İşlem ID -->
                <StackPanel Orientation="Horizontal" Margin="0 20 0 0" VerticalAlignment="Center">
                    <TextBlock Text="İşlem ID:" Margin="0 0 20 0" VerticalAlignment="Center" Style="{StaticResource Arayuztext}"/>
                    <TextBox Width="251" FontSize="18" Style="{StaticResource kutucuk}" Foreground="White"/>
                </StackPanel>
            </StackPanel>

            <!-- Dosya İşlemleri (SAĞ ALTA) -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 20 0 0" Grid.Row="1">
                <Button Width="144" Height="40" Style="{StaticResource ModernButton}" Margin="10 0">
                    <StackPanel Orientation="Horizontal">
                        <fa:IconBlock Icon="FileImport" Width="20" Margin="0 0 10 0"/>
                        <TextBlock Text="Dosya Al" Style="{StaticResource butontext}"/>
                    </StackPanel>
                </Button>

                <Button Width="144" Height="40" Style="{StaticResource ModernButton}" Margin="10 0">
                    <StackPanel Orientation="Horizontal">
                        <fa:IconBlock Icon="FileExport" Width="20" Margin="0 0 10 0"/>
                        <TextBlock Text="Dosya Gönder" Style="{StaticResource butontext}"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
